{
    "name": "ianfoxdev/psp-sandbox-php",
    "description": "PHP client for psp-sandbox: drive failure scenarios from tests, inspect callback deliveries and verify signatures.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "payments",
        "psp",
        "testing",
        "webhooks",
        "sandbox",
        "mock"
    ],
    "homepage": "https://github.com/ianfoxdev/psp-sandbox",
    "authors": [
        {
            "name": "Anatoly Pankratyev",
            "email": "ianfoxdeveloper@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/http-client": "^7.3"
    },
    "suggest": {
        "phpunit/phpunit": "for the InteractsWithSandbox test trait"
    },
    "autoload": {
        "psr-4": {
            "PspSandbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PspSandbox\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    }
}
