{
    "name": "ghuser/psp-sandbox-php",
    "description": "PHP client for psp-sandbox: pick failure scenarios from tests and verify signed callbacks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["payments", "psp", "testing", "webhooks", "sandbox", "mock"],
    "homepage": "https://github.com/ghuser/psp-sandbox",
    "authors": [
        { "name": "Anatoly Pankratyev", "email": "ianfoxdeveloper@gmail.com" }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "PspSandbox\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PspSandbox\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
