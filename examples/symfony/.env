# Defaults for the example. Real environment variables (compose.yaml) win.
APP_ENV=dev
APP_SECRET=not-a-secret-example-only
DEFAULT_URI=http://localhost

DATABASE_URL=pdo-pgsql://shop:shop@postgres:5432/shop

# Where the application calls the provider, and where the provider calls back.
PSP_URL=http://psp:8090
PSP_CALLBACK_BASE_URL=http://app:8000
PSP_WEBHOOK_SECRET=whsec_dGVzdC1zZWNyZXQ=
# safe or naive: which callback handler the checkout registers with the provider.
PSP_CALLBACK_HANDLER=safe

# Used by the tests to inspect the sandbox.
PSP_SANDBOX_URL=http://psp:8090

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
