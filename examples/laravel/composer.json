{
    "name": "ianfoxdev/psp-sandbox-laravel-example",
    "description": "Laravel shop wired to psp-sandbox: a naive and a safe payment callback handler, and tests that tell them apart.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ianfoxdev/psp-sandbox-php": "*@dev",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../clients/php"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
