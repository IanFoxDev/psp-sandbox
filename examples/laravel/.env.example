APP_NAME=psp-sandbox-laravel-example
APP_ENV=local
APP_KEY=base64:8xNVs1S0ZKxGEz0FOr2Jp6sAFY1rMp5oS0cMDQdW1bE=
APP_DEBUG=true

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=shop

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Where the application calls the provider, and where the provider calls back.
PSP_URL=http://psp:8090
PSP_CALLBACK_BASE_URL=http://app:8000
PSP_WEBHOOK_SECRET=whsec_dGVzdC1zZWNyZXQ=
# safe or naive: which callback handler the checkout registers with the provider.
PSP_CALLBACK_HANDLER=safe

# Used by the tests to inspect the sandbox.
PSP_SANDBOX_URL=http://psp:8090
